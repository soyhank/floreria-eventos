---
interface Props { items?: string[]; dark?: boolean }
const { items = ['Ramos de rosas', 'Arreglos box', 'Bodas', 'Quinceañeros', 'Inauguraciones', 'Centros de mesa', 'Cumpleaños', 'Flores para cada momento'], dark = false } = Astro.props;
const row = [...items, ...items];
---
<div class:list={['border-y py-5', dark ? 'border-ivory/10 bg-forest text-ivory/80' : 'border-forest/10 bg-ivory-2/70 text-forest/80']} aria-hidden="true">
  <div class="flex overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
    <div class="flex shrink-0 animate-marquee items-center gap-10 pr-10">
      {row.map((t) => (
        <span class="flex items-center gap-10 whitespace-nowrap font-display text-2xl italic">
          {t} <span class="h-1.5 w-1.5 rounded-full bg-fuchsia"></span>
        </span>
      ))}
    </div>
  </div>
</div>
