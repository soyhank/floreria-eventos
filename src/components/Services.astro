---
import { wa } from '../data/site';
import Icons from './Icons.astro';
const services = [
  { icon: 'star', title: 'Inauguraciones', text: 'Arreglos de pie con cinta y dedicatoria para aperturas de negocios, oficinas y locales.', href: '#catalogo' },
  { icon: 'heart', title: 'Bodas', text: 'Ambientación floral del pasillo, altar, mesas y bouquet de la novia, en el estilo de la ceremonia.', href: '#eventos' },
  { icon: 'chef', title: 'Quinceañeros', text: 'Centros de mesa altos, arcos y detalles florales en la paleta de colores de la fiesta.', href: '#eventos' },
  { icon: 'clock', title: 'Regalos y fechas especiales', text: 'Ramos, arreglos box y canastas de cumpleaños con globos y chocolates, listos para entregar.', href: '#catalogo' },
] as const;
---
<section id="servicios" class="scroll-mt-24 py-16 sm:py-24">
  <div class="container-x">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">Nuestros servicios</p>
        <h2 class="mt-4 text-4xl font-medium leading-tight tracking-tight sm:text-5xl">
          Flores para regalar,<br /><em class="font-light italic text-terra">flores para celebrar.</em>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-cocoa">
          Nos dedicamos a la venta de flores, arreglos florales y decoración de eventos especiales
          como inauguraciones, bodas o quince años. Trabajamos cada pedido a tu medida: color, tamaño,
          estilo y fecha de entrega.
        </p>
        <a href={wa('Hola 👋, quisiera cotizar la decoración floral de un evento. Tipo de evento: ___ · Fecha: ___ · Lugar: ___')} target="_blank" rel="noopener" class="btn-primary mt-8">
          Cotizar mi evento <Icons name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2">
        {services.map((s, i) => (
          <li class="reveal rounded-3xl border border-choco/10 bg-white/60 p-5 transition hover:-translate-y-0.5 hover:shadow-soft" style={`transition-delay:${i * 70}ms`}>
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-terra/10 text-terra"><Icons name={s.icon} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-display text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mocha">{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
