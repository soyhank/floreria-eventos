---
import { products, categories, fmt } from '../data/products';
import { wa } from '../data/site';
import Icons from './Icons.astro';
const orderMsg = (n: string) => `Hola 👋, me interesa: ${n}. ¿Me pueden dar más información y disponibilidad?`;
---
<section id="catalogo" class="scroll-mt-24 bg-cream-2/50 py-16 sm:py-24">
  <div class="container-x">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between reveal">
      <div>
        <p class="eyebrow">Catálogo</p>
        <h2 class="mt-4 text-4xl font-medium leading-tight tracking-tight sm:text-5xl">Arreglos y precios</h2>
        <p class="mt-3 max-w-lg text-cocoa">Precios referenciales en soles. Cada arreglo se personaliza en flores, colores y tamaño; la cotización final se confirma por WhatsApp.</p>
      </div>
      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filtrar por categoría" id="cat-tabs">
        {categories.map((c, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-cat={c.id}
            class="rounded-full border px-4 py-2 text-sm font-medium transition aria-selected:bg-choco aria-selected:text-cream aria-selected:border-choco border-choco/15 bg-white/60 text-cocoa hover:border-choco/40">
            {c.label}
          </button>
        ))}
      </div>
    </div>

    <div id="cat-grid" class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p, i) => (
        <article data-cat={p.cat} class="group reveal flex flex-col overflow-hidden rounded-3xl bg-white shadow-soft ring-1 ring-choco/5 transition duration-300 hover:-translate-y-1 hover:shadow-lift" style={`transition-delay:${(i % 3) * 70}ms`}>
          <a href={wa(orderMsg(p.name))} target="_blank" rel="noopener" class="relative block overflow-hidden" aria-label={`Consultar ${p.name} por WhatsApp`}>
            <img src={p.img} alt={p.name} width="640" height="800" loading="lazy" class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-105" />
            <span class="absolute left-3 top-3 rounded-full bg-cream/95 px-3 py-1 text-xs font-bold text-choco shadow-soft">
              {p.priceNote === 'desde' && <span class="font-medium text-mocha">desde </span>}{fmt(p.price)}{p.priceNote && p.priceNote !== 'desde' && <span class="font-medium text-mocha"> {p.priceNote}</span>}
            </span>
            <span class="absolute right-3 top-3 rounded-full bg-choco/70 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-cream backdrop-blur">{categories.find((c) => c.id === p.cat)?.label}</span>
          </a>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-display text-xl font-semibold leading-snug">{p.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mocha">{p.desc}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {p.tags.map((t) => <li class="rounded-full bg-cream-2 px-2.5 py-1 text-[11px] font-medium text-cocoa">{t}</li>)}
            </ul>
            <a href={wa(orderMsg(p.name))} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-terra transition hover:text-terra-2">
              Consultar por WhatsApp <Icons name="arrow" class="h-4 w-4 transition group-hover:translate-x-0.5" />
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 rounded-3xl bg-choco px-6 py-8 text-cream sm:flex-row sm:px-10 reveal">
      <div>
        <p class="font-display text-2xl font-semibold">¿Tienes otra idea en mente?</p>
        <p class="mt-1 text-cream/70">Cuéntanos la ocasión, los colores y tu presupuesto: diseñamos el arreglo para ti.</p>
      </div>
      <a href={wa('Hola 👋, quisiera un arreglo personalizado. Ocasión: ___ · Colores: ___ · Presupuesto: ___')} target="_blank" rel="noopener" class="btn-wa shrink-0"><Icons name="wa" class="h-4 w-4" /> Pedir a medida</a>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('#cat-tabs [role=tab]');
  const cards = document.querySelectorAll<HTMLElement>('#cat-grid [data-cat]');
  const apply = (cat: string) => {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.cat === cat)));
    cards.forEach((c) => { c.classList.toggle('hidden', !(cat === 'todos' || c.dataset.cat === cat)); c.classList.add('in'); });
  };
  tabs.forEach((t) => t.addEventListener('click', () => apply(t.dataset.cat!)));
</script>
