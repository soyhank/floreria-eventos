---
import { wa } from '../data/site';
import Icons from './Icons.astro';
---
<a href={wa()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"
   class="group fixed bottom-5 right-5 z-40 flex items-center gap-2 rounded-full bg-wa p-3.5 text-white shadow-lift transition-all duration-500 hover:pr-5 hover:scale-105 [transition-timing-function:var(--ease-out-expo)]">
  <span class="absolute inset-0 -z-10 animate-ping rounded-full bg-wa/50 [animation-duration:2.6s] motion-reduce:hidden"></span>
  <Icons name="wa" class="h-6 w-6" />
  <span class="max-w-0 overflow-hidden whitespace-nowrap text-sm font-semibold transition-all duration-500 group-hover:max-w-[8rem] sm:max-w-[8rem]">Cotizar</span>
</a>
