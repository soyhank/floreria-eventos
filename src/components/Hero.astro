---
import { wa } from '../data/site';
import Icons from './Icons.astro';
---
<section id="top" class="relative overflow-hidden pt-28 sm:pt-32">
  <div aria-hidden="true" class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-terra/15 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-20 top-40 h-80 w-80 rounded-full bg-gold/25 blur-3xl"></div>

  <div class="container-x">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8">
      <div class="reveal in">
        <p class="eyebrow">Florería · Decoración de eventos</p>
        <h1 class="mt-5 text-[2.75rem] font-medium leading-[1.02] tracking-tight sm:text-6xl lg:text-[4.4rem]">
          Flores que <em class="font-light italic text-terra">celebran</em><br />tus momentos.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-cocoa">
          Venta de flores, arreglos y decoración para eventos especiales: inauguraciones, bodas y quinceañeros.
          Ramos, arreglos box, centros de mesa y detalles de cumpleaños hechos a tu medida.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={wa()} target="_blank" rel="noopener" class="btn-wa"><Icons name="wa" class="h-4 w-4" /> Cotizar por WhatsApp</a>
          <a href="#catalogo" class="btn-outline">Ver catálogo <Icons name="arrow" class="h-4 w-4" /></a>
        </div>
        <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-choco/10 pt-6">
          <div><dt class="text-xs uppercase tracking-widest text-mocha">Arreglos desde</dt><dd class="mt-1 font-display text-xl font-semibold sm:text-2xl">S/ 100</dd></div>
          <div><dt class="text-xs uppercase tracking-widest text-mocha">Eventos</dt><dd class="mt-1 font-display text-xl font-semibold sm:text-2xl">Bodas y XV</dd></div>
          <div><dt class="text-xs uppercase tracking-widest text-mocha">Diseño</dt><dd class="mt-1 font-display text-xl font-semibold sm:text-2xl">A medida</dd></div>
        </dl>
      </div>

      <div class="relative mx-auto w-full max-w-md reveal in lg:ml-auto lg:mr-0 lg:max-w-[30rem]">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-lift">
          <img src="/img/hero.webp" alt="Decoración floral de boda: pasillo con arreglos de flores blancas y rosadas y cortinas verde agua" width="800" height="1000" fetchpriority="high" class="h-full w-full object-cover" />
        </div>
        <div class="absolute -left-4 bottom-10 hidden w-44 rotate-[-4deg] overflow-hidden rounded-2xl bg-cream shadow-lift ring-1 ring-choco/10 sm:block lg:-left-10">
          <img src="/img/ramo-sq.webp" alt="" width="480" height="480" class="aspect-square w-full object-cover" />
          <p class="px-3 py-2 text-xs font-semibold">Ramo de rosas <span class="text-terra">S/ 400</span></p>
        </div>
        <div class="absolute -right-3 top-8 hidden rotate-[5deg] items-center gap-2 rounded-2xl bg-cream px-4 py-3 shadow-lift ring-1 ring-choco/10 sm:flex lg:-right-8">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-gold/20 text-[#5f8f1e]"><Icons name="heart" class="h-5 w-5" /></span>
          <span class="text-sm font-semibold leading-tight">Flores frescas<br /><span class="font-normal text-mocha">para cada ocasión</span></span>
        </div>
      </div>
    </div>
  </div>
</section>
