---
import { site, wa } from '../data/site';
import Icons from './Icons.astro';
const quick = [
  { label: 'Ramo o arreglo para regalar', msg: 'Hola 👋, quisiera un ramo o arreglo para regalar. Ocasión: ___ · Fecha de entrega: ___' },
  { label: 'Arreglo de cumpleaños', msg: 'Hola 👋, quisiera un arreglo de cumpleaños con globos. Fecha de entrega: ___' },
  { label: 'Decoración de boda o 15 años', msg: 'Hola 👋, quisiera cotizar la decoración floral de mi evento. Tipo: ___ · Fecha: ___ · Lugar: ___' },
  { label: 'Arreglo de inauguración', msg: 'Hola 👋, quisiera un arreglo de inauguración con dedicatoria. Fecha: ___ · Empresa: ___' },
];
---
<section id="contacto" class="scroll-mt-24 relative py-16 sm:py-24">
  <div aria-hidden="true" class="grid-paper pointer-events-none absolute inset-x-0 bottom-0 h-56"></div>
  <div class="container-x relative">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
      <div class="reveal">
        <p class="eyebrow">Contacto</p>
        <h2 class="mt-4 font-display text-5xl font-medium leading-[1.05] tracking-tight sm:text-6xl">
          <em class="font-light italic text-terra">Flores</em><br />para cada momento.
        </h2>
        <p class="mt-5 max-w-md text-lg text-cocoa">Escríbenos por WhatsApp para pedir tu arreglo o cotizar la decoración de tu evento. Coordinamos la entrega para la fecha que necesites.</p>
        <a href={wa()} target="_blank" rel="noopener" class="btn-wa mt-8 !px-7 !py-4 !text-base"><Icons name="wa" class="h-5 w-5" /> +51 {site.phone}</a>
        <p class="mt-3 text-sm text-mocha">Atención por WhatsApp · Pedidos y eventos con anticipación</p>
      </div>

      <div class="grid gap-3 reveal">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-mocha">¿Qué necesitas? Elige y te llevamos al chat</p>
        {quick.map((q) => (
          <a href={wa(q.msg)} target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-2xl border border-choco/10 bg-white/60 p-4 transition hover:-translate-y-0.5 hover:border-terra/40 hover:shadow-soft">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-choco text-cream transition group-hover:bg-terra"><Icons name="wa" class="h-5 w-5" /></span>
            <span class="font-semibold">{q.label}</span>
            <Icons name="arrow" class="ml-auto h-5 w-5 shrink-0 text-mocha transition group-hover:translate-x-1 group-hover:text-terra" />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
