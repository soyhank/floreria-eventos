---
import type { Product } from '../data/products';
import { fmt, categories } from '../data/products';
import Icons from './Icons.astro';
interface Props { p: Product; index?: number }
const { p, index = 0 } = Astro.props;
const catLabel = categories.find((c) => c.id === p.cat)?.label;
---
<article data-cat={p.cat} data-reveal="up" style={`--d:${(index % 3) * 90}ms`} class="tilt group relative overflow-hidden rounded-[1.6rem] bg-white shadow-soft ring-1 ring-forest/5 hover:shadow-lift">
  <a href={`/catalogo/${p.slug}`} class="block" aria-label={`Ver ${p.name}`}>
    <div class="relative overflow-hidden">
      <img src={p.img} alt={p.name} width="640" height="800" loading="lazy" class="aspect-[4/5] w-full object-cover transition duration-[1.2s] [transition-timing-function:var(--ease-out-expo)] group-hover:scale-110" transition:name={`img-${p.slug}`} />
      <div class="absolute inset-0 bg-gradient-to-t from-forest/70 via-forest/0 to-transparent opacity-0 transition duration-700 group-hover:opacity-100"></div>
      <span class="absolute left-4 top-4 rounded-full bg-ivory/95 px-3 py-1.5 text-xs font-bold text-forest shadow-soft">
        {p.priceNote === 'desde' && <span class="font-medium text-muted">desde </span>}{fmt(p.price)}{p.priceNote && p.priceNote !== 'desde' && <span class="font-medium text-muted"> {p.priceNote}</span>}
      </span>
      <span class="absolute right-4 top-4 rounded-full bg-forest/60 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-ivory backdrop-blur">{catLabel}</span>
      <span class="absolute bottom-4 left-4 right-4 flex translate-y-4 items-center justify-between text-ivory opacity-0 transition duration-700 [transition-timing-function:var(--ease-out-expo)] group-hover:translate-y-0 group-hover:opacity-100">
        <span class="text-sm font-semibold">Ver detalle</span>
        <span class="grid h-9 w-9 place-items-center rounded-full bg-ivory text-forest"><Icons name="arrow-up-right" class="h-4 w-4" /></span>
      </span>
    </div>
    <div class="p-5">
      <h3 class="font-display text-2xl font-semibold leading-tight">{p.name}</h3>
      <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{p.desc}</p>
      <ul class="mt-3 flex flex-wrap gap-1.5">{p.tags.map((t) => <li class="rounded-full bg-ivory-2 px-2.5 py-1 text-[11px] font-medium text-forest/80">{t}</li>)}</ul>
    </div>
  </a>
</article>
