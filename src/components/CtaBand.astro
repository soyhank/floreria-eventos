---
import { wa } from '../data/site';
import Icons from './Icons.astro';
interface Props { title?: string; text?: string; msg?: string; label?: string }
const { title = '¿Tienes una fecha en mente?', text = 'Cuéntanos la ocasión, los colores y tu presupuesto. Te respondemos por WhatsApp con una propuesta.', msg = 'Hola 👋, quisiera cotizar un arreglo o evento. Ocasión: ___ · Fecha: ___', label = 'Cotizar por WhatsApp' } = Astro.props;
---
<section class="container-x py-16 sm:py-20">
  <div class="relative overflow-hidden rounded-[2rem] bg-forest px-7 py-12 text-ivory sm:px-12 grain" data-reveal="zoom">
    <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-fuchsia/30 blur-3xl animate-blob"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 left-1/3 h-64 w-64 rounded-full bg-leaf/20 blur-3xl animate-blob [animation-delay:-8s]"></div>
    <div class="relative flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="h-display text-4xl sm:text-5xl">{title}</h2>
        <p class="mt-3 max-w-xl text-ivory/70">{text}</p>
      </div>
      <a href={wa(msg)} target="_blank" rel="noopener" class="btn btn-wa shrink-0 !px-7 !py-4 !text-base"><Icons name="wa" class="h-5 w-5" /> {label}</a>
    </div>
  </div>
</section>
