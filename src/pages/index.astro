---
import Layout from '../layouts/Layout.astro';
import Petals from '../components/Petals.astro';
import Marquee from '../components/Marquee.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icons from '../components/Icons.astro';
import { wa } from '../data/site';
import { products } from '../data/products';

const featured = ['ramo', 'box', 'cumpleanos'].map((s) => products.find((p) => p.slug === s)!);
const services = [
  { title: 'Bodas', text: 'Pasillo, altar, mesas y bouquet: ambientación floral completa para tu ceremonia.', img: '/img/boda.webp', href: '/eventos#bodas', price: 'desde S/ 2000' },
  { title: 'Quinceañeros', text: 'Centros de mesa altos y detalles en la paleta de colores de la fiesta.', img: '/img/centro-mesa.webp', href: '/eventos#quince', price: 'centros S/ 100 c/u' },
  { title: 'Inauguraciones', text: 'Arreglos de pie con cinta y dedicatoria para aperturas y aniversarios de empresa.', img: '/img/inauguracion.webp', href: '/eventos#inauguraciones', price: 'desde S/ 100' },
];
const heroWords = 'Flores que celebran'.split(' ');
---
<Layout dark>
  <!-- HERO -->
  <section class="relative isolate min-h-[100svh] overflow-hidden bg-forest text-ivory grain">
    <img src="/img/hero.webp" alt="" width="800" height="1000" fetchpriority="high" class="kenburns absolute inset-0 h-full w-full object-cover object-center opacity-45" />
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-forest via-forest/80 to-forest/20"></div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-forest to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 top-1/3 h-[28rem] w-[28rem] rounded-full bg-fuchsia/25 blur-3xl animate-blob"></div>
    <div aria-hidden="true" class="pointer-events-none absolute right-10 top-10 h-72 w-72 rounded-full bg-leaf/20 blur-3xl animate-blob [animation-delay:-7s]"></div>
    <Petals />

    <div class="container-x relative flex min-h-[100svh] flex-col justify-center pb-24 pt-32">
      <p class="eyebrow eyebrow-light" data-reveal="fade">Florería · Decoración de eventos</p>
      <h1 class="h-display words mt-6 max-w-5xl text-[3.4rem] sm:text-7xl lg:text-[6.5rem]">
        {heroWords.map((w) => <span><span>{w}&nbsp;</span></span>)}
        <br class="hidden sm:block" />
        <span><span class="font-light italic text-blush">tus&nbsp;</span></span><span><span class="font-light italic text-blush">momentos.</span></span>
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ivory/75" data-reveal="up" style="--d:700ms">
        Ramos, arreglos box y canastas para regalar; ambientación floral para bodas, quinceañeros e inauguraciones. Diseñado a tu medida, con flores frescas.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal="up" style="--d:850ms">
        <a href="/catalogo" class="btn btn-light">Ver catálogo <Icons name="arrow" class="h-4 w-4" /></a>
        <a href={wa()} target="_blank" rel="noopener" class="btn btn-wa"><Icons name="wa" class="h-4 w-4" /> Cotizar por WhatsApp</a>
      </div>

      <div class="mt-16 grid max-w-xl grid-cols-3 gap-6 border-t border-ivory/15 pt-6" data-reveal="up" style="--d:1000ms">
        <div><p class="font-display text-4xl font-semibold"><span data-count="100" data-prefix="S/ ">S/ 0</span></p><p class="mt-1 text-[11px] uppercase tracking-[0.2em] text-ivory/55">Arreglos desde</p></div>
        <div><p class="font-display text-4xl font-semibold"><span data-count="6">0</span>+</p><p class="mt-1 text-[11px] uppercase tracking-[0.2em] text-ivory/55">Líneas de producto</p></div>
        <div><p class="font-display text-4xl font-semibold"><span data-count="3">0</span></p><p class="mt-1 text-[11px] uppercase tracking-[0.2em] text-ivory/55">Tipos de evento</p></div>
      </div>
    </div>

    <a href="#servicios" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-ivory/60 transition hover:text-ivory" aria-label="Bajar">
      <span class="block h-10 w-px animate-pulse bg-ivory/50"></span>
    </a>
  </section>

  <Marquee dark />

  <!-- SERVICIOS -->
  <section id="servicios" class="scroll-mt-24 bg-ivory py-20 text-ink sm:py-28">
    <div class="container-x">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div data-reveal="up">
          <p class="eyebrow">Eventos</p>
          <h2 class="h-display mt-4 text-4xl sm:text-6xl">Ambientamos <em class="font-light italic text-fuchsia">tu gran día</em></h2>
        </div>
        <a href="/eventos" class="link-underline self-start text-sm font-semibold uppercase tracking-[0.18em] text-forest md:self-auto" data-reveal="fade">Ver todos los servicios</a>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3" data-stagger="120">
        {services.map((s, i) => (
          <a href={s.href} data-reveal="up" class={`group relative block overflow-hidden rounded-[1.8rem] shadow-soft ${i === 1 ? 'md:mt-12' : ''}`}>
            <img src={s.img} alt={s.title} width="640" height="800" loading="lazy" class="aspect-[3/4] w-full object-cover transition duration-[1.4s] [transition-timing-function:var(--ease-out-expo)] group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-forest/90 via-forest/25 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-6 text-ivory">
              <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-blush">{s.price}</p>
              <h3 class="mt-2 font-display text-3xl font-semibold">{s.title}</h3>
              <p class="mt-2 max-h-0 overflow-hidden text-sm text-ivory/80 opacity-0 transition-all duration-700 [transition-timing-function:var(--ease-out-expo)] group-hover:max-h-24 group-hover:opacity-100">{s.text}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold">Descubrir <Icons name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DESTACADOS -->
  <section class="bg-ivory-2/60 py-20 text-ink sm:py-28">
    <div class="container-x">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div data-reveal="up">
          <p class="eyebrow">Para regalar</p>
          <h2 class="h-display mt-4 text-4xl sm:text-6xl">Detalles que <em class="font-light italic text-fuchsia">enamoran</em></h2>
          <p class="mt-4 max-w-lg text-muted">Ramos, arreglos box y canastas de cumpleaños. Cada pieza se personaliza en flores, colores y tamaño.</p>
        </div>
        <a href="/catalogo" class="btn btn-outline self-start md:self-auto" data-reveal="fade">Ver catálogo completo <Icons name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p, i) => <ProductCard p={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- MANIFIESTO / VALORES -->
  <section class="relative overflow-hidden bg-forest py-24 text-ivory sm:py-32 grain">
    <div aria-hidden="true" class="pointer-events-none absolute -right-32 top-0 h-[30rem] w-[30rem] rounded-full bg-fuchsia/20 blur-3xl animate-blob"></div>
    <div class="container-x relative grid items-center gap-14 lg:grid-cols-[1fr_1fr]">
      <div data-reveal="left">
        <p class="eyebrow eyebrow-light">Nuestra promesa</p>
        <h2 class="h-display mt-5 text-4xl sm:text-6xl">Frescura, diseño <em class="font-light italic text-blush">y cariño</em> en cada arreglo.</h2>
        <p class="mt-6 max-w-lg text-lg text-ivory/70">Nos dedicamos a la venta de flores, arreglos y decoración de eventos especiales. Trabajamos cada pedido contigo: escuchamos la ocasión, proponemos flores y colores, y lo entregamos listo para sorprender.</p>
        <a href="/nosotros" class="btn btn-outline-light mt-8">Conócenos <Icons name="arrow" class="h-4 w-4" /></a>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2" data-stagger="110">
        {[
          { icon: 'leaf', t: 'Flores frescas', d: 'Seleccionadas para que tu arreglo luzca y dure.' },
          { icon: 'sparkle', t: 'Diseño a medida', d: 'Colores, tamaño y estilo según la ocasión.' },
          { icon: 'ring', t: 'Eventos completos', d: 'De un centro de mesa a la ambientación integral.' },
          { icon: 'truck', t: 'Entrega coordinada', d: 'Programamos la entrega o montaje para tu fecha.' },
        ].map((v) => (
          <li data-reveal="up" class="rounded-3xl border border-ivory/10 bg-ivory/5 p-6 backdrop-blur-sm transition duration-500 hover:-translate-y-1 hover:bg-ivory/10">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-blush/20 text-blush"><Icons name={v.icon as any} class="h-5 w-5" /></span>
            <h3 class="mt-4 font-display text-2xl font-semibold">{v.t}</h3>
            <p class="mt-1.5 text-sm text-ivory/65">{v.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="bg-ivory py-20 text-ink sm:py-28">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center" data-reveal="up">
        <p class="eyebrow justify-center before:hidden">Cómo trabajamos</p>
        <h2 class="h-display mt-4 text-4xl sm:text-6xl">Tres pasos <em class="font-light italic text-fuchsia">y listo</em></h2>
      </div>
      <ol class="mt-14 grid gap-6 md:grid-cols-3" data-stagger="140">
        {[
          { n: '01', t: 'Cuéntanos', d: 'Ocasión, fecha, colores y presupuesto por WhatsApp.' },
          { n: '02', t: 'Te proponemos', d: 'Referencias, flores sugeridas y cotización el mismo día.' },
          { n: '03', t: 'Entregamos', d: 'Arreglo listo o montaje en el local, en la fecha acordada.' },
        ].map((s) => (
          <li data-reveal="up" class="group relative rounded-[1.8rem] border border-forest/10 bg-white p-8 transition duration-500 hover:-translate-y-1 hover:shadow-lift">
            <span class="font-display text-6xl font-light text-blush-2 transition group-hover:text-fuchsia">{s.n}</span>
            <h3 class="mt-4 font-display text-2xl font-semibold">{s.t}</h3>
            <p class="mt-2 text-muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="bg-ivory text-ink"><CtaBand /></div>
</Layout>
