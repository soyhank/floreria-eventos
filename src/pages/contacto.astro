---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icons from '../components/Icons.astro';
import { site, wa } from '../data/site';

const quick = [
  { icon: 'gift', label: 'Ramo o arreglo para regalar', msg: 'Hola 👋, quisiera un ramo o arreglo para regalar. Ocasión: ___ · Fecha de entrega: ___' },
  { icon: 'sparkle', label: 'Arreglo de cumpleaños', msg: 'Hola 👋, quisiera un arreglo de cumpleaños con globos. Fecha de entrega: ___' },
  { icon: 'ring', label: 'Decoración de boda o 15 años', msg: 'Hola 👋, quisiera cotizar la decoración floral de mi evento. Tipo: ___ · Fecha: ___ · Lugar: ___' },
  { icon: 'star', label: 'Arreglo de inauguración', msg: 'Hola 👋, quisiera un arreglo de inauguración con dedicatoria. Fecha: ___ · Empresa: ___' },
] as const;
const faqs = [
  { q: '¿Con cuánta anticipación debo pedir?', a: 'Para ramos y arreglos, cuanto antes mejor para asegurar las flores que quieres; para eventos (bodas, quinceañeros) recomendamos coordinar con varias semanas de anticipación para reservar la fecha. Consúltanos por WhatsApp la disponibilidad para tu fecha.' },
  { q: '¿Los precios son fijos?', a: 'Los precios del catálogo son referenciales ("desde"). La cotización final depende de la cantidad y tipo de flores, el tamaño y la fecha, y se confirma por WhatsApp antes de tomar el pedido.' },
  { q: '¿Hacen entregas y montaje?', a: 'Sí. Coordinamos la entrega del arreglo o el montaje de la decoración en el local del evento para la fecha y hora acordadas. La cobertura y el costo de traslado se confirman según la zona.' },
  { q: '¿Puedo elegir colores y flores?', a: 'Claro. Cada arreglo se personaliza: color de rosas, combinación de flores, tamaño, globos, chocolates y tarjeta con dedicatoria.' },
];
---
<Layout dark title="Contacto — Flores & Eventos" description="Escríbenos por WhatsApp al +51 916 973 823 para pedir tu arreglo o cotizar la decoración de tu evento.">
  <PageHero eyebrow="Contacto" title="Hablemos de" accent="tu ocasión." text="Escríbenos por WhatsApp para pedir tu arreglo o cotizar la decoración de tu evento. Coordinamos la entrega para la fecha que necesites." compact />

  <div class="bg-ivory text-ink">
    <section class="py-16 sm:py-24">
      <div class="container-x grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div data-reveal="left">
          <a href={wa()} target="_blank" rel="noopener" class="group block rounded-[2rem] bg-forest p-8 text-ivory shadow-lift transition duration-500 hover:-translate-y-1 grain relative overflow-hidden">
            <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-wa/30 blur-3xl"></div>
            <span class="relative grid h-14 w-14 place-items-center rounded-2xl bg-wa text-white"><Icons name="wa" class="h-7 w-7" /></span>
            <p class="relative mt-6 text-[11px] font-semibold uppercase tracking-[0.3em] text-blush">WhatsApp</p>
            <p class="relative mt-2 font-display text-4xl font-semibold">+51 {site.phone}</p>
            <p class="relative mt-2 text-sm text-ivory/65">Toca para abrir el chat · Atención por WhatsApp</p>
            <span class="relative mt-6 inline-flex items-center gap-2 text-sm font-semibold">Escribir ahora <Icons name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" /></span>
          </a>
          <ul class="mt-6 space-y-3 text-sm text-muted">
            <li class="flex items-center gap-3"><Icons name="clock" class="h-4 w-4 text-fuchsia" /> Pedidos y eventos con anticipación</li>
            <li class="flex items-center gap-3"><Icons name="truck" class="h-4 w-4 text-fuchsia" /> Entregas y montajes coordinados según la zona</li>
            <li class="flex items-center gap-3"><Icons name="leaf" class="h-4 w-4 text-fuchsia" /> Perú</li>
          </ul>
        </div>

        <div data-reveal="right">
          <p class="eyebrow">Atajos</p>
          <h2 class="h-display mt-4 text-4xl sm:text-5xl">¿Qué necesitas? <em class="font-light italic text-fuchsia">Elige y te llevamos al chat</em></h2>
          <div class="mt-8 grid gap-3" data-stagger="90">
            {quick.map((q) => (
              <a href={wa(q.msg)} target="_blank" rel="noopener" data-reveal="up" class="group flex items-center gap-4 rounded-2xl border border-forest/10 bg-white p-4 transition duration-500 hover:-translate-y-0.5 hover:border-fuchsia/40 hover:shadow-soft">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-forest text-ivory transition group-hover:bg-fuchsia"><Icons name={q.icon} class="h-5 w-5" /></span>
                <span class="font-semibold">{q.label}</span>
                <Icons name="arrow" class="ml-auto h-5 w-5 shrink-0 text-muted transition group-hover:translate-x-1 group-hover:text-fuchsia" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ivory-2/60 py-16 sm:py-24">
      <div class="container-x max-w-4xl">
        <div class="text-center" data-reveal="up">
          <p class="eyebrow justify-center before:hidden">Preguntas frecuentes</p>
          <h2 class="h-display mt-4 text-4xl sm:text-5xl">Antes de <em class="font-light italic text-fuchsia">pedir</em></h2>
        </div>
        <div class="mt-10 divide-y divide-forest/10 rounded-[1.6rem] border border-forest/10 bg-white" data-stagger="80">
          {faqs.map((f, i) => (
            <details data-reveal="up" class="group px-6" name="faq" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-2xl font-semibold marker:content-none">
                {f.q}
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-forest/15 transition duration-500 group-open:rotate-45 group-open:bg-forest group-open:text-ivory"><Icons name="x" class="h-4 w-4 rotate-45" /></span>
              </summary>
              <p class="pb-6 text-ink/75 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
